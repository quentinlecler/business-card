{
  "type": "module",
  "devDependencies": {
    "@playwright/cli": "^0.1.21",
    "@playwright/test": "1.64.0-alpha-1789764292000",
    "jsdom": "30.1.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "4.0.2"
  },
  "scripts": {
    "vendor": "node vendor.mjs",
    "build:site": "node scripts/build-site.mjs",
